{
  "name": "@luma/dsh-plugin",
  "version": "0.6.8",
  "description": "从鲸鱼娘开始，收集伙伴与房间，在 DeepSeek Harness 中聊天、协作和保存记忆。",
  "private": true,
  "type": "module",
  "main": "./native-desktop/server.mjs",
  "exports": {
    ".": "./native-desktop/server.mjs",
    "./client": "./native-desktop/client.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml", "platforms": ["win32"] },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
